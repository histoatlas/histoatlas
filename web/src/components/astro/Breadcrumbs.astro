---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="flex items-center gap-1.5 text-sm text-zinc-500">
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="text-zinc-300">/</span>}
      {item.href ? (
        <a href={item.href} class="hover:text-zinc-700 transition-colors">{item.label}</a>
      ) : (
        <span class="text-zinc-900 font-medium">{item.label}</span>
      )}
    </>
  ))}
</nav>
