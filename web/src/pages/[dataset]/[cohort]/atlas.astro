---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { AtlasPageIsland } from '../../../islands/AtlasPageIsland';
import { COHORT_FULL_NAMES } from '../../../data/cohortNames';
import { TCGA_TO_SLUG } from '../../../data/cancerSlugs';
import { getMutationPagesForCancer } from '../../../data/mutationPages';
import { GENE_BY_SLUG } from '../../../data/geneGlossary';
import { TIER1_SEO_CONTENT } from '../../../data/seoContent';
import { ALL_FEATURES } from '../../../data/featureGlossary';

export function getStaticPaths() {
  const manifest = JSON.parse(readFileSync('public/api/_manifests/datasets.json', 'utf-8'));
  const paths = [];
  for (const [dataset, info] of Object.entries(manifest)) {
    for (const cohort of (info as any).cancerTypes) {
      paths.push({ params: { dataset, cohort } });
    }
  }
  return paths;
}

const { dataset, cohort } = Astro.params;
const displayCohort = cohort ?? 'PANCAN';
const cohortFullName = COHORT_FULL_NAMES[displayCohort] ?? displayCohort;
const isPancan = displayCohort === 'PANCAN';
const datasetDisplayName = dataset?.toUpperCase() ?? 'TCGA';
const h1Text = isPancan ? `${datasetDisplayName} Pan-Cancer` : `${datasetDisplayName} ${cohortFullName}`;

const cancerSlug = TCGA_TO_SLUG[displayCohort];
const mutationPages = cancerSlug ? getMutationPagesForCancer(cancerSlug) : [];

const tier1Features = Object.keys(TIER1_SEO_CONTENT)
  .map((name) => {
    const entry = ALL_FEATURES.find((f) => f.name === name);
    return entry ? { name: entry.name, displayName: entry.displayName } : null;
  })
  .filter((f): f is { name: string; displayName: string } => f !== null);
---

<BaseLayout
  title={`${cohortFullName} Histopathology Atlas - ${datasetDisplayName} · HistoAtlas`}
  description={`Interactive UMAP embedding visualization for the ${datasetDisplayName} ${cohortFullName} (${displayCohort}) cohort.`}
  canonicalUrl={`/${dataset}/${displayCohort}/atlas/`}
  breadcrumbs={[
    { name: datasetDisplayName, url: `/${dataset}/PANCAN/atlas/` },
    { name: cohortFullName, url: `/${dataset}/${displayCohort}/atlas/` },
  ]}
>
  <div class="min-h-screen bg-zinc-50">
    <!-- White header zone with breadcrumbs -->
    <div class="bg-white">
      <div class="max-w-7xl mx-auto px-6 pt-6">
        <Breadcrumbs items={[{ label: datasetDisplayName, href: `/${dataset}/PANCAN/atlas/` }, { label: cohortFullName }]} />
      </div>
    </div>

    <!-- SSR header with portal slots for React interactive widgets -->
    <div class="bg-white border-b border-zinc-200">
      <div class="max-w-7xl mx-auto px-6 pt-3 pb-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h1 class="text-xl font-semibold text-zinc-900">{h1Text}</h1>
            <p class="text-sm text-zinc-500 mt-1">Interactive UMAP embedding visualization for the {datasetDisplayName} {cohortFullName} cohort.</p>
          </div>
          <div class="flex items-center gap-3">
            <div id="cohort-selector-slot" class="hidden md:block" style="min-width:180px;min-height:36px;"></div>
            <div id="download-button-slot" style="min-width:120px;min-height:36px;"></div>
          </div>
        </div>
        {mutationPages.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3">
            <span class="text-xs font-medium text-zinc-500 uppercase tracking-wide">Common Mutations</span>
            {mutationPages.slice(0, 8).map((p) => (
              <a href={`/mutations/${p.geneSlug}/${p.cancerSlug}/`}
                 class="text-sm text-blue-600 hover:underline">
                {GENE_BY_SLUG[p.geneSlug]?.symbol ?? p.geneSlug.toUpperCase()} ({(p.frequency * 100).toFixed(0)}%)
              </a>
            ))}
          </div>
        )}
        {tier1Features.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3">
            <span class="text-xs font-medium text-zinc-500 uppercase tracking-wide">Key Histomic Features</span>
            {tier1Features.map((f) => (
              <a href={`/${dataset}/${displayCohort}/histomics/${encodeURIComponent(f.name)}/`}
                 class="text-sm text-blue-600 hover:underline">
                {f.displayName}
              </a>
            ))}
          </div>
        )}
      </div>
      <div id="tab-nav-slot"></div>
    </div>

    <AtlasPageIsland dataset={dataset} cohort={displayCohort} client:only="react" />
  </div>
</BaseLayout>

<script is:inline define:vars={{ dataset, cohort: displayCohort }}>
  window.posthog?.capture('cohort_atlas_viewed', { dataset, cohort });
</script>
