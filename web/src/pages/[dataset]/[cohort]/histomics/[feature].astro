---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/astro/Breadcrumbs.astro';
import { HistomicsPageIsland } from '../../../../islands/HistomicsPageIsland';
import { ALL_FEATURES } from '../../../../data/featureGlossary';
import { COHORT_FULL_NAMES, ATLAS_COHORTS } from '../../../../data/cohortNames';
import { TIER1_SEO_CONTENT, isTier1Feature, TIER2_TO_TIER1_HUB, TIER1_HUB_LABEL } from '../../../../data/seoContent';
import katex from 'katex';
import 'katex/dist/katex.min.css';

export function getStaticPaths() {
  const manifest = JSON.parse(readFileSync('public/api/_manifests/datasets.json', 'utf-8'));
  const paths = [];
  for (const [dataset, info] of Object.entries(manifest)) {
    for (const cohort of (info as any).cancerTypes) {
      for (const f of ALL_FEATURES) {
        paths.push({ params: { dataset, cohort, feature: f.name } });
      }
    }
  }
  return paths;
}

const { dataset, cohort, feature } = Astro.params;
const displayCohort = cohort ?? 'PANCAN';
const decodedFeature = feature ? decodeURIComponent(feature) : '';

// Look up display name and description from glossary
const glossaryEntry = ALL_FEATURES.find((f) => f.name === decodedFeature);
const displayName = glossaryEntry?.displayName ?? decodedFeature.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const glossaryDescription = glossaryEntry?.description ?? '';
const formulaHtml = glossaryEntry?.formula
  ? katex.renderToString(glossaryEntry.formula, { displayMode: false, throwOnError: false, strict: false })
  : '';

// Cohort full name for meta tags
const cohortFullName = COHORT_FULL_NAMES[displayCohort] ?? displayCohort;
const isPancan = displayCohort === 'PANCAN';
const datasetDisplayName = dataset?.toUpperCase() ?? 'TCGA';

// Tier 1 SEO content
const isTier1 = isTier1Feature(decodedFeature);
const seoContent = isTier1 ? TIER1_SEO_CONTENT[decodedFeature] : null;

// Pre-render KaTeX formulas in educational intro and rewrite internal links
// to use the current dataset (seoContent may have hardcoded /tcga/ links).
const educationalIntroHtml = seoContent?.educationalIntro
  ? seoContent.educationalIntro
      .replace(/href="\/tcga\//g, `href="/${dataset}/`)
      .replace(
        /<span data-tex="([^"]+)"><\/span>/g,
        (_, tex: string) => {
          const decoded = tex.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');
          const isBlock = decoded.includes('\\frac') || decoded.includes('\\sum');
          return katex.renderToString(decoded, { displayMode: isBlock, throwOnError: false, strict: false });
        }
      )
  : '';

// --- Title tag ---
let pageTitle: string;
if (seoContent) {
  const baseTitle = isPancan
    ? seoContent.pancanTitle
    : seoContent.perCancerTitle(cohortFullName);
  // Append dataset for non-TCGA cohorts to disambiguate while keeping keyword front-loaded
  pageTitle = datasetDisplayName === 'TCGA' ? baseTitle : baseTitle.replace(' | HistoAtlas', ` — ${datasetDisplayName} | HistoAtlas`);
} else {
  pageTitle = `${displayName} in ${cohortFullName}: Survival, Correlations & Data — ${datasetDisplayName} | HistoAtlas`;
}

// --- Meta description ---
let metaDescription: string;
if (seoContent) {
  const baseMeta = isPancan
    ? seoContent.pancanMetaDescription
    : seoContent.perCancerMetaDescription(cohortFullName);
  // Replace hardcoded "TCGA" with the actual dataset name for non-TCGA cohorts
  metaDescription = datasetDisplayName === 'TCGA' ? baseMeta : baseMeta.replace(/TCGA/g, datasetDisplayName);
} else {
  metaDescription = `${displayName} in ${cohortFullName} (${datasetDisplayName}): survival, molecular & mutation data. Free research platform.`;
}

// --- FAQs (Tier 1 PANCAN only) ---
const faqs = (isTier1 && isPancan && seoContent) ? seoContent.faqs : [];

// --- JSON-LD for FAQPage ---
const jsonLd: Record<string, unknown>[] = [];
if (faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

// --- Internal links: per-cancer cohort entries (used by both PANCAN and per-cancer SEO sections) ---
const cohortEntries = Object.entries(COHORT_FULL_NAMES)
  .filter(([abbr]) => abbr !== 'PANCAN' && ATLAS_COHORTS.has(abbr));

// --- Related features (Tier 1 PANCAN only) ---
const relatedFeatures = (isTier1 && isPancan && seoContent)
  ? seoContent.relatedFeatures
      .map((name) => {
        const entry = ALL_FEATURES.find((f) => f.name === name);
        return entry ? { name: entry.name, displayName: entry.displayName } : null;
      })
      .filter((f): f is { name: string; displayName: string } => f !== null)
  : [];

// --- Tier 2 → Tier 1 hub cross-link ---
const tier1HubName = TIER2_TO_TIER1_HUB[decodedFeature] ?? null;
const tier1HubEntry = tier1HubName ? ALL_FEATURES.find((f) => f.name === tier1HubName) : null;
const tier1HubLabel = tier1HubName ? TIER1_HUB_LABEL[tier1HubName] : null;
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={`/${dataset}/${displayCohort}/histomics/${encodeURIComponent(decodedFeature)}/`}
  breadcrumbs={[
    { name: datasetDisplayName, url: `/${dataset}/PANCAN/atlas/` },
    { name: cohortFullName, url: `/${dataset}/${displayCohort}/atlas/` },
    { name: 'Histomics', url: `/${dataset}/${displayCohort}/histomics/` },
    { name: displayName },
  ]}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-zinc-50">
    <!-- White header zone (server-rendered for SEO) -->
    <div class="bg-white">
      <div class="max-w-7xl mx-auto px-6 pt-6">
        <Breadcrumbs items={[
          { label: datasetDisplayName, href: `/${dataset}/PANCAN/atlas/` },
          { label: cohortFullName, href: `/${dataset}/${displayCohort}/atlas/` },
          { label: 'Histomics', href: `/${dataset}/${displayCohort}/histomics/` },
          { label: displayName },
        ]} />
      </div>
      <div class="max-w-7xl mx-auto px-6 pt-3 pb-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h1 class="text-2xl font-semibold text-zinc-900">{displayName}</h1>
            <p class="text-sm text-zinc-500 mt-1 font-mono">{decodedFeature}</p>
            {glossaryDescription && <p class="text-sm text-zinc-600 mt-2 max-w-2xl">{glossaryDescription}</p>}
          </div>
          <div id="cohort-selector-slot" class="hidden md:block flex-shrink-0 pt-1" style="min-width:200px;min-height:36px;"></div>
        </div>
      </div>
    </div>

    <!-- React island: cohort selector + tab bar + content -->
    <HistomicsPageIsland dataset={dataset} feature={decodedFeature} cohort={displayCohort} client:only="react" />

    <!-- Feature description card (server-rendered for SEO, moved into React slot on mount) -->
    {glossaryEntry && (
      <div id="feature-description-card" style="position:absolute;left:-9999px;">
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400 mt-0.5 shrink-0"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap mb-2">
                <h2 class="text-lg font-semibold text-zinc-900">{glossaryEntry.displayName}</h2>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-zinc-100 text-zinc-600">{glossaryEntry.section}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-zinc-100 text-zinc-600">{glossaryEntry.unit}</span>
              </div>
              <p class="text-sm text-zinc-600 leading-relaxed mb-2">{glossaryEntry.description}</p>
              {formulaHtml && (
                <span class="text-zinc-700" role="math" aria-label={glossaryEntry.formula}>
                  <Fragment set:html={formulaHtml} />
                </span>
              )}
              {isTier1 && isPancan && educationalIntroHtml && (
                <details class="mt-4 group">
                  <summary class="inline-flex items-center gap-1.5 text-sm text-zinc-500 hover:text-zinc-700 cursor-pointer select-none transition-colors list-none [&::-webkit-details-marker]:hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-90"><path d="m9 18 6-6-6-6"/></svg>
                    Learn more about {displayName.toLowerCase()}
                  </summary>
                  <div class="mt-3 pl-[20.5px] text-sm leading-relaxed text-zinc-500 space-y-2 [&_strong]:text-zinc-700 [&_strong]:font-medium [&_a]:text-blue-600 [&_.formula-block]:my-3 [&_.formula-block]:text-center [&_.formula-block]:text-zinc-700">
                    <Fragment set:html={educationalIntroHtml} />
                  </div>
                </details>
              )}
            </div>
          </div>
        </div>
      </div>
    )}

    <script>
      // Move the SSR feature card into the React-rendered slot.
      // When the slot disappears (tab switch), move it back off-screen; when it reappears, move it in again.
      const card = document.getElementById('feature-description-card');
      if (card) {
        const originalParent = card.parentElement!;
        const originalNext = card.nextElementSibling;
        const show = () => { card.style.position = ''; card.style.left = ''; };
        const hide = () => { card.style.position = 'absolute'; card.style.left = '-9999px'; };
        const observer = new MutationObserver(() => {
          const slot = document.getElementById('feature-card-slot');
          if (slot && card.parentElement !== slot) {
            slot.appendChild(card);
            show();
          } else if (!slot && card.parentElement !== originalParent) {
            originalParent.insertBefore(card, originalNext);
            hide();
          }
        });
        observer.observe(document.body, { childList: true, subtree: true });
      }
    </script>

    <!-- SEO sections -->
    <div class="max-w-7xl mx-auto px-6 py-6 space-y-6">
      <!-- FAQ section (Tier 1 PANCAN only) -->
      {isTier1 && isPancan && faqs.length > 0 && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            Frequently Asked Questions
          </h2>
          {faqs.map((faq) => (
            <details class="border-b border-zinc-100 last:border-0">
              <summary class="py-3 text-sm font-medium text-zinc-800 cursor-pointer hover:text-zinc-600 transition-colors">{faq.question}</summary>
              <p class="pb-3 text-sm text-zinc-600">{faq.answer}</p>
            </details>
          ))}
        </div>
      )}

      <!-- Explore by Cancer Type (PANCAN pages — all features) -->
      {isPancan && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
            Explore by Cancer Type
          </h2>
          <div class="flex flex-wrap gap-2">
            {cohortEntries.map(([abbr, fullName]) => (
              <a href={`/${dataset}/${abbr}/histomics/${encodeURIComponent(decodedFeature)}/`} class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">{fullName}</a>
            ))}
          </div>
        </div>
      )}

      <!-- Per-cancer pages: link to PANCAN hub + sibling cancer types -->
      {!isPancan && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
            {displayName} in Other Cohorts
          </h2>
          <div class="flex flex-wrap gap-2">
            <a href={`/${dataset}/PANCAN/histomics/${encodeURIComponent(decodedFeature)}/`} class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded-full hover:bg-blue-100 hover:border-blue-300 transition-colors">Pan-Cancer Overview</a>
            {cohortEntries.filter(([abbr]) => abbr !== displayCohort).map(([abbr, fullName]) => (
              <a href={`/${dataset}/${abbr}/histomics/${encodeURIComponent(decodedFeature)}/`} class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">{fullName}</a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Features (Tier 1 PANCAN only) -->
      {isTier1 && isPancan && relatedFeatures.length > 0 && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            Related Features
          </h2>
          <div class="flex flex-wrap gap-2">
            {relatedFeatures.map((rf) => (
              <a href={`/${dataset}/PANCAN/histomics/${encodeURIComponent(rf.name)}/`} class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">{rf.displayName}</a>
            ))}
          </div>
        </div>
      )}

      <!-- See Also cross-link (Tier 2 pages only) -->
      {!isTier1 && tier1HubEntry && tier1HubLabel && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            See Also
          </h2>
          <p class="text-sm text-zinc-600 mb-3">{displayName} is related to {tier1HubEntry.displayName} — explore the full cross-cancer analysis.</p>
          <a href={`/${dataset}/PANCAN/histomics/${encodeURIComponent(tier1HubEntry.name)}/`} class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">{tier1HubLabel}: Cross-Cancer Analysis</a>
        </div>
      )}
    </div>

    <!-- Provenance bar (rendered by React via portal) -->
    <div id="provenance-slot" class="max-w-7xl mx-auto px-6 pb-6"></div>
  </div>
</BaseLayout>
