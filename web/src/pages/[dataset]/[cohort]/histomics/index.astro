---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/astro/Breadcrumbs.astro';
import { HistomicsTableIsland } from '../../../../islands/HistomicsTableIsland';
import { COHORT_FULL_NAMES } from '../../../../data/cohortNames';

export function getStaticPaths() {
  const manifest = JSON.parse(readFileSync('public/api/_manifests/datasets.json', 'utf-8'));
  const paths = [];
  for (const [dataset, info] of Object.entries(manifest)) {
    for (const cohort of (info as any).cancerTypes) {
      paths.push({ params: { dataset, cohort } });
    }
  }
  return paths;
}

const { dataset, cohort } = Astro.params;
const displayCohort = cohort ?? 'PANCAN';
const cohortFullName = COHORT_FULL_NAMES[displayCohort] ?? displayCohort;
const datasetDisplayName = dataset?.toUpperCase() ?? 'TCGA';
---

<BaseLayout
  title={`${cohortFullName} Histomics — ${datasetDisplayName} · HistoAtlas`}
  description={`Browse all histomic features for the ${datasetDisplayName} ${cohortFullName} (${displayCohort}) cohort.`}
  canonicalUrl={`/${dataset}/${displayCohort}/histomics/`}
  breadcrumbs={[
    { name: datasetDisplayName, url: `/${dataset}/PANCAN/atlas/` },
    { name: cohortFullName, url: `/${dataset}/${displayCohort}/atlas/` },
    { name: 'Histomics' },
  ]}
>
  <div class="min-h-screen bg-zinc-50">
    <!-- White header zone (breadcrumbs only — title moved to React island) -->
    <div class="bg-white">
      <div class="max-w-7xl mx-auto px-6 pt-6">
        <Breadcrumbs items={[{ label: datasetDisplayName, href: `/${dataset}/PANCAN/atlas/` }, { label: cohortFullName, href: `/${dataset}/${displayCohort}/atlas/` }, { label: 'Histomics' }]} />
      </div>
    </div>

    <!-- SSR header with portal slot for React interactive widgets -->
    <div class="bg-white border-b border-zinc-200">
      <div class="max-w-7xl mx-auto px-6 pt-3 pb-5">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h1 class="text-2xl font-semibold text-zinc-900">Histomics</h1>
            <p class="text-sm text-zinc-500 mt-1">Browse all histomic features for the {datasetDisplayName} {cohortFullName} cohort.</p>
          </div>
          <div id="cohort-selector-slot" class="hidden md:block pt-1" style="min-width:180px;min-height:36px;"></div>
        </div>
      </div>
    </div>

    <!-- React island: title + cohort selector + table -->
    <HistomicsTableIsland dataset={dataset} cohort={displayCohort} client:only="react" />
  </div>
</BaseLayout>
