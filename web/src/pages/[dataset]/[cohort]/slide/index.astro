---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const manifest = JSON.parse(readFileSync('public/api/_manifests/datasets.json', 'utf-8'));
  const paths = [];
  for (const [dataset, info] of Object.entries(manifest)) {
    for (const cohort of (info as any).cancerTypes) {
      paths.push({ params: { dataset, cohort } });
    }
  }
  return paths;
}

const { dataset, cohort } = Astro.params;
const displayCohort = cohort ?? 'PANCAN';
---

<BaseLayout
  title={`HistoAtlas · ${displayCohort} Slides`}
  description={`Browse slides for the ${displayCohort} cohort.`}
  canonicalUrl={`/${dataset}/${displayCohort}/atlas/`}
  noindex={true}
>
  <main class="max-w-3xl mx-auto px-6 py-20 text-center">
    <p class="text-sm text-zinc-500">Redirecting to atlas...</p>
    <a href={`/${dataset}/${displayCohort}/atlas/`} class="text-blue-600 hover:underline">Open Atlas</a>
  </main>
</BaseLayout>
