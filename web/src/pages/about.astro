---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AboutIsland } from '../islands/AboutIsland';
---

<BaseLayout
  title="HistoAtlas · About"
  description="Why HistoAtlas exists: a structured atlas for cancer morphology linking tissue organization with molecular signatures and patient outcomes."
  canonicalUrl="/about/"
  ogImage="/og/about.png"
>
  <main class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-semibold text-zinc-900 mb-3">About HistoAtlas</h1>
    <p class="text-zinc-500 text-lg mb-8">
      Why this atlas exists.
    </p>
    <AboutIsland client:visible />
  </main>
</BaseLayout>
