---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<BaseLayout
  title="HistoAtlas · Blog"
  description="Educational articles on computational pathology, genomics, and cancer biology, backed by pan-cancer data from HistoAtlas."
  canonicalUrl="/blog/"
  ogImage="/og/blog.png"
>
  <main class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-semibold text-zinc-900 mb-3">Blog</h1>
    <p class="text-zinc-500 text-lg mb-8">
      Educational articles on computational pathology, genomics, and cancer biology.
    </p>
      {posts.length === 0 ? (
        <p class="text-zinc-500 text-center py-16">No posts yet.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {posts.map((post) => {
            const slug = post.id.replace(/\/index\.mdx?$/, '').replace(/\.mdx?$/, '');
            const date = new Date(post.data.pubDate).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            const keyword = post.data.keywords[0];
            return (
              <a
                href={`/blog/${slug}/`}
                class="group block bg-white border border-zinc-200 rounded-lg overflow-hidden hover:border-zinc-300 transition-colors"
              >
                {post.data.heroImage && (
                  <div class="aspect-[3/2] bg-zinc-50 border-b border-zinc-100 overflow-hidden">
                    <img
                      src={post.data.heroImage}
                      alt={post.data.heroAlt}
                      width="600"
                      height="400"
                      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-5">
                  <h2 class="text-[15px] font-semibold text-zinc-900 leading-snug group-hover:text-zinc-700 transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="mt-1.5 text-sm text-zinc-500 line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="mt-3 flex items-center gap-3 text-xs text-zinc-400">
                    <time datetime={post.data.pubDate}>{date}</time>
                    {keyword && (
                      <>
                        <span class="text-zinc-300">&middot;</span>
                        <span class="inline-flex items-center rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600">
                          {keyword}
                        </span>
                      </>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
  </main>
</BaseLayout>
