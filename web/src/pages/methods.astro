---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MethodsIsland } from '../islands/MethodsIsland';
---

<BaseLayout
  title="HistoAtlas · Methods"
  description="Image analysis pipeline and statistical methods documentation."
  canonicalUrl="/methods/"
  ogImage="/og/methods.png"
>
  <main class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-semibold text-zinc-900 mb-3">Methods</h1>
    <p class="text-zinc-500 text-lg mb-8">
      Comprehensive documentation of the image analysis pipeline and statistical methods.
    </p>
    <MethodsIsland client:visible />
  </main>
</BaseLayout>
