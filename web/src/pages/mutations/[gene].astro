---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import { MutationHubIsland } from '../../islands/MutationHubIsland';
import { GENE_BY_SLUG, TRACKED_GENES } from '../../data/geneGlossary';
import { GENE_SEO_CONTENT, hasGeneSeoContent } from '../../data/geneSeoContent';
import { getMutationPagesForGene } from '../../data/mutationPages';
import { SLUG_TO_FULL_NAME } from '../../data/cancerSlugs';

export function getStaticPaths() {
  return TRACKED_GENES.map((g) => ({ params: { gene: g.slug } }));
}

const { gene } = Astro.params;
const geneSlug = gene ?? '';
const entry = GENE_BY_SLUG[geneSlug]!;

const seoContent = hasGeneSeoContent(geneSlug) ? GENE_SEO_CONTENT[geneSlug] : null;
const mutationPages = getMutationPagesForGene(geneSlug);
const relatedGenes = TRACKED_GENES.filter((g) => g.slug !== geneSlug);

// Title
const pageTitle = seoContent
  ? seoContent.hubTitle
  : `${entry.symbol} Mutation in Cancer: Frequency, Survival & Morphology Data | HistoAtlas`;

// Meta description
const metaDescription = seoContent
  ? seoContent.hubMetaDescription
  : `Explore ${entry.symbol} mutation frequency across 33 cancer types. Interactive survival curves, morphological features, and statistical analysis. Free research platform.`;

// FAQs
const faqs = seoContent ? seoContent.faqs : [];

// JSON-LD
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `${entry.symbol} Mutation Data`,
    description: `Mutation frequency, survival analysis, and morphology associations for ${entry.symbol} across 33 TCGA cancer types.`,
    url: `https://histoatlas.com/mutations/${geneSlug}/`,
    creator: { '@type': 'Organization', name: 'HistoAtlas' },
    license: 'https://creativecommons.org/licenses/by/4.0/',
    measurementTechnique: 'Computational histopathology, Cox proportional hazards regression',
    variableMeasured: ['Mutation frequency', 'Overall survival', 'Histopathology features'],
  },
];
if (faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={`/mutations/${geneSlug}/`}
  breadcrumbs={[
    { name: 'Mutations', url: '/mutations/' },
    { name: entry.symbol },
  ]}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-zinc-50">
    <!-- White header zone -->
    <div class="bg-white border-b border-zinc-200">
      <div class="max-w-7xl mx-auto px-6 pt-6">
        <Breadcrumbs items={[
          { label: 'Mutations', href: '/mutations/' },
          { label: entry.symbol },
        ]} />
      </div>
      <div class="max-w-7xl mx-auto px-6 pt-3 pb-5">
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-semibold text-zinc-900">{entry.symbol} Mutation in Cancer</h1>
          <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
            entry.geneType === 'Oncogene'
              ? 'bg-red-50 text-red-700'
              : 'bg-blue-50 text-blue-700'
          }`}>
            {entry.geneType}
          </span>
        </div>
        <p class="text-sm text-zinc-500 mt-1">{entry.fullName}</p>
        <p class="text-sm text-zinc-600 mt-2 max-w-3xl">{entry.summary}</p>
      </div>
    </div>

    <!-- React island: frequency chart, survival forest, morphology table -->
    <MutationHubIsland gene={geneSlug} client:only="react" />

    <div class="max-w-7xl mx-auto px-6 py-6 space-y-6">
      <!-- Educational intro (SEO content) -->
      {seoContent && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5 prose prose-zinc max-w-none prose-headings:text-zinc-900 prose-h2:text-lg prose-h2:font-semibold prose-h2:mt-6 [&>h2:first-of-type]:!mt-0 prose-h2:mb-2 prose-h3:text-base prose-h3:font-medium prose-h3:mt-4 prose-h3:mb-1.5 prose-p:text-sm prose-p:text-zinc-600 prose-p:my-2 prose-a:text-blue-600 prose-strong:text-zinc-800">
          <Fragment set:html={seoContent.educationalIntro} />
        </div>
      )}

      <!-- FAQ section -->
      {faqs.length > 0 && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            Frequently Asked Questions
          </h2>
          {faqs.map((faq) => (
            <details class="border-b border-zinc-100 last:border-0">
              <summary class="py-3 text-sm font-medium text-zinc-800 cursor-pointer hover:text-zinc-600 transition-colors">{faq.question}</summary>
              <p class="pb-3 text-sm text-zinc-600">{faq.answer}</p>
            </details>
          ))}
        </div>
      )}

      <!-- Explore by Cancer Type -->
      {mutationPages.length > 0 && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
            Explore by Cancer Type
          </h2>
          <div class="flex flex-wrap gap-2">
            {mutationPages.map((page) => (
              <a
                href={`/mutations/${page.geneSlug}/${page.cancerSlug}/`}
                class="inline-flex items-center gap-2 px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors"
              >
                <span>{SLUG_TO_FULL_NAME[page.cancerSlug] ?? page.cancerSlug}</span>
                <span class="text-xs text-zinc-400 font-mono">{(page.frequency * 100).toFixed(0)}%</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Mutations -->
      <div class="bg-white border border-zinc-200 rounded-lg p-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          Related Mutations
        </h2>
        <div class="flex flex-wrap gap-2">
          {relatedGenes.map((g) => (
            <a href={`/mutations/${g.slug}/`} class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">{g.symbol}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
