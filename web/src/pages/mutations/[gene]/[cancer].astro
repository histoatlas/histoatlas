---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import { MutationIntersectionIsland } from '../../../islands/MutationIntersectionIsland';
import { GENE_BY_SLUG } from '../../../data/geneGlossary';
import { GENE_SEO_CONTENT, hasGeneSeoContent } from '../../../data/geneSeoContent';
import { MUTATION_PAGES, getMutationPagesForGene, getMutationPagesForCancer } from '../../../data/mutationPages';
import { SLUG_TO_TCGA, SLUG_TO_FULL_NAME } from '../../../data/cancerSlugs';

export function getStaticPaths() {
  return MUTATION_PAGES.map((p) => ({
    params: { gene: p.geneSlug, cancer: p.cancerSlug },
  }));
}

const { gene, cancer } = Astro.params;
const geneSlug = gene ?? '';
const cancerSlug = cancer ?? '';

const geneEntry = GENE_BY_SLUG[geneSlug]!;
const tcgaCode = SLUG_TO_TCGA[cancerSlug]!;
const cancerFullName = SLUG_TO_FULL_NAME[cancerSlug]!;

const seoContent = hasGeneSeoContent(geneSlug) ? GENE_SEO_CONTENT[geneSlug] : null;

// Approximate frequency for meta description
const pageEntry = getMutationPagesForGene(geneSlug).find((p) => p.cancerSlug === cancerSlug);
const freqPct = pageEntry ? (pageEntry.frequency * 100).toFixed(0) : '?';

// Title
const pageTitle = seoContent
  ? seoContent.intersectionTitle(cancerFullName)
  : `${geneEntry.symbol} Mutation in ${cancerFullName}: Survival Impact & Histopathology | HistoAtlas`;

// Meta description
const metaDescription = seoContent
  ? seoContent.intersectionMetaDescription(cancerFullName, freqPct)
  : `${geneEntry.symbol} mutation in ${cancerFullName}: ${freqPct}% prevalence. Kaplan-Meier survival curves, hazard ratios, and histopathology features. Free TCGA data.`;

// Sibling pages: same gene, other cancers
const sameGeneCancers = getMutationPagesForGene(geneSlug).filter((p) => p.cancerSlug !== cancerSlug);

// Same cancer, other genes
const sameCancerGenes = getMutationPagesForCancer(cancerSlug).filter((p) => p.geneSlug !== geneSlug);

// JSON-LD
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `${geneEntry.symbol} Mutations in ${cancerFullName}`,
    description: `Survival analysis, morphology associations, and co-occurrence data for ${geneEntry.symbol} mutations in ${cancerFullName} (TCGA ${tcgaCode}).`,
    url: `https://histoatlas.com/mutations/${geneSlug}/${cancerSlug}/`,
    creator: { '@type': 'Organization', name: 'HistoAtlas' },
    license: 'https://creativecommons.org/licenses/by/4.0/',
    measurementTechnique: 'Computational histopathology, Cox proportional hazards regression',
    variableMeasured: ['Mutation frequency', 'Overall survival', 'Histopathology features', 'Mutation co-occurrence'],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={`/mutations/${geneSlug}/${cancerSlug}/`}
  breadcrumbs={[
    { name: 'Mutations', url: '/mutations/' },
    { name: geneEntry.symbol, url: `/mutations/${geneSlug}/` },
    { name: cancerFullName },
  ]}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-zinc-50">
    <!-- White header zone -->
    <div class="bg-white border-b border-zinc-200">
      <div class="max-w-7xl mx-auto px-6 pt-6">
        <Breadcrumbs items={[
          { label: 'Mutations', href: '/mutations/' },
          { label: geneEntry.symbol, href: `/mutations/${geneSlug}/` },
          { label: cancerFullName },
        ]} />
      </div>
      <div class="max-w-7xl mx-auto px-6 pt-3 pb-5">
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-semibold text-zinc-900">{geneEntry.symbol} Mutation in {cancerFullName}</h1>
          <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
            geneEntry.geneType === 'Oncogene'
              ? 'bg-red-50 text-red-700'
              : 'bg-blue-50 text-blue-700'
          }`}>
            {geneEntry.geneType}
          </span>
        </div>
        <p class="text-sm text-zinc-600 mt-2 max-w-3xl">
          {geneEntry.symbol} mutations occur in approximately <strong>{freqPct}%</strong> of {cancerFullName} cases.
          Explore survival impact, morphological differences, and co-occurring mutations below.
        </p>
      </div>
    </div>

    <!-- React island: KM curve, morphology diffs, co-occurrence -->
    <MutationIntersectionIsland gene={geneSlug} cancerSlug={cancerSlug} client:only="react" />

    <!-- Explore Further -->
    <div class="max-w-7xl mx-auto px-6 py-6 space-y-6">
      <!-- Same gene, other cancers -->
      {sameGeneCancers.length > 0 && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
            {geneEntry.symbol} in Other Cancer Types
          </h2>
          <div class="flex flex-wrap gap-2">
            {sameGeneCancers.map((p) => (
              <a
                href={`/mutations/${p.geneSlug}/${p.cancerSlug}/`}
                class="inline-flex items-center gap-2 px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors"
              >
                <span>{SLUG_TO_FULL_NAME[p.cancerSlug] ?? p.cancerSlug}</span>
                <span class="text-xs text-zinc-400 font-mono">{(p.frequency * 100).toFixed(0)}%</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Same cancer, other genes -->
      {sameCancerGenes.length > 0 && (
        <div class="bg-white border border-zinc-200 rounded-lg p-5">
          <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            Other Mutations in {cancerFullName}
          </h2>
          <div class="flex flex-wrap gap-2">
            {sameCancerGenes.map((p) => {
              const gEntry = GENE_BY_SLUG[p.geneSlug];
              return (
                <a
                  href={`/mutations/${p.geneSlug}/${p.cancerSlug}/`}
                  class="inline-flex items-center gap-2 px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors"
                >
                  <span>{gEntry?.symbol ?? p.geneSlug.toUpperCase()}</span>
                  <span class="text-xs text-zinc-400 font-mono">{(p.frequency * 100).toFixed(0)}%</span>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Link to cohort atlas page -->
      <div class="bg-white border border-zinc-200 rounded-lg p-5">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          Explore Further
        </h2>
        <div class="flex flex-wrap gap-2">
          <a href={`/tcga/${tcgaCode}/atlas/`} class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">
            {cancerFullName} Atlas
          </a>
          <a href={`/mutations/${geneSlug}/`} class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">
            {geneEntry.symbol} Pan-Cancer Overview
          </a>
          <a href="/mutations/" class="inline-flex items-center px-3 py-1.5 text-sm text-zinc-700 bg-zinc-50 border border-zinc-200 rounded-full hover:bg-zinc-100 hover:border-zinc-300 transition-colors">
            All Mutations
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
